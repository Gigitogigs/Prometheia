# ============================================================================
# Prometheia Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit the real .env file to version control!
#
# ============================================================================
# DJANGO SETTINGS
# ============================================================================

DJANGO_SECRET_KEY=django-insecure-generate-with-python-c-from-django-core-management-utils-import-get_random_secret_key-print-get_random_secret_key
DJANGO_DEBUG=True

# For production, add your domain
ALLOWED_HOSTS=localhost,127.0.0.1,.ngrok-free.app

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

DB_ENGINE=django.db.backends.postgresql
DB_NAME=prometheia
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_HOST=localhost
DB_PORT=5432

# ============================================================================
# GITHUB API & WEBHOOKS
# ============================================================================

# Generate from GitHub Settings → Developer settings → Personal access tokens
# Scopes: repo, admin:repo_hook
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Generate a random secret for webhook validation (32+ characters)
# Used to verify GitHub webhook signatures
GITHUB_WEBHOOK_SECRET=your_webhook_secret_key_here_min_32_chars

# ============================================================================
# GOOGLE GEMINI API (AI EVALUATION)
# ============================================================================

# Get from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# OPIK OBSERVABILITY & TRACING
# ============================================================================

# Get from Comet Opik: https://www.comet.com/opik
OPIK_API_KEY=your_opik_api_key_here
OPIK_WORKSPACE=default
OPIK_ENABLED=True

# ============================================================================
# REDIS & CELERY (TASK QUEUE)
# ============================================================================

# Redis URL for task queue and caching
# Local: redis://localhost:6379/0
# Docker: redis://redis:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ============================================================================
# CORS (FRONTEND INTEGRATION)
# ============================================================================

# Allow requests from your frontend domain
# Local development: http://localhost:3000
# Production: https://yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================================================
# EMAIL CONFIGURATION (OPTIONAL)
# ============================================================================

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password_here

# ============================================================================
# SECURITY SETTINGS
# ============================================================================

# HTTPS/SSL (set to True in production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# HSTS (HTTP Strict Transport Security - for production)
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# ============================================================================
# LOGGING
# ============================================================================

DJANGO_LOG_LEVEL=INFO

# ============================================================================
# RATE LIMITING & THROTTLING
# ============================================================================

# Webhook rate limit: requests per hour per IP
WEBHOOK_RATE_LIMIT=1000

# API rate limit: requests per minute for authenticated users
API_RATE_LIMIT_AUTHENTICATED=100

# API rate limit: requests per minute for anonymous users
API_RATE_LIMIT_ANONYMOUS=30

# ============================================================================
# CACHING
# ============================================================================

# Cache timeout in seconds (default 5 minutes)
CACHE_TIMEOUT=300

# Leaderboard cache timeout (default 5 minutes)
LEADERBOARD_CACHE_TIMEOUT=300

# ============================================================================
# STRIPE (FUTURE - MONETIZATION)
# ============================================================================

# STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# ============================================================================
# SOCIAL AUTH (GITHUB OAUTH)
# ============================================================================

# GitHub OAuth App credentials (from https://github.com/settings/developers)
GITHUB_OAUTH_CLIENT_ID=your_github_oauth_client_id
GITHUB_OAUTH_CLIENT_SECRET=your_github_oauth_client_secret

# ============================================================================
# FRONTEND SETTINGS (IF RUNNING LOCALLY)
# ============================================================================

# Frontend URL for redirects (e.g., after OAuth callback)
FRONTEND_URL=http://localhost:3000

# ============================================================================
# CELERY SETTINGS
# ============================================================================

CELERY_ALWAYS_EAGER=False
CELERY_EAGER_PROPAGATES_EXCEPTIONS=True
CELERY_TASK_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================

# Sentry (Error tracking - optional)
# SENTRY_DSN=https://xxxxxxxxxxxx@xxxxx.ingest.sentry.io/xxxxxxxx

# ============================================================================
# NOTES
# ============================================================================

# To generate a Django secret key:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# To generate a webhook secret:
# python -c "import secrets; print(secrets.token_hex(32))"

# For local development, most settings can stay as defaults
# For production, ensure DJANGO_DEBUG=False and all secrets are strong
